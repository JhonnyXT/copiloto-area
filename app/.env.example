# Copia este archivo a .env.local y pon valores reales (nunca este archivo).
# Las variables de Neon/Vercel Blob (DATABASE_URL, BLOB_STORE_ID, etc.) las
# trae automáticamente `vercel env pull .env.local` — no se escriben a mano.

# Better Auth
BETTER_AUTH_SECRET=   # genera uno con: openssl rand -base64 32
BETTER_AUTH_URL=http://localhost:3100   # en producción: la URL real; en Preview, déjala vacía

# Login con Google (ver docs/plan-tecnico.md, sección Auth, para cómo crearlo)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Lista cerrada de correos permitidos, separados por coma. Sin esto, nadie
# puede crear cuenta (comportamiento seguro por defecto).
CORREOS_PERMITIDOS=
